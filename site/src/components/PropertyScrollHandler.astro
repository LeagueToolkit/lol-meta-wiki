---
// This component handles scrolling to property cards when TOC links are clicked
// It maps the Markdown heading IDs (lowercase, slugified) to the actual property names
interface Props {
  properties: { name: string }[];
}

const { properties } = Astro.props;

// Create a mapping of slugified names to actual names
const propertyMap = properties.reduce(
  (acc, prop) => {
    // Starlight's slug generation: lowercase and replace spaces with hyphens
    const slug = prop.name.toLowerCase().replace(/\s+/g, "-");
    acc[slug] = prop.name;
    return acc;
  },
  {} as Record<string, string>
);
---

<script define:vars={{ propertyMap }}>
  // The #<slug> ids live on hidden headings at the bottom of the page (they
  // exist for the TOC and Pagefind sub-results), so every navigation to a
  // property anchor must be redirected to the matching visible card: TOC
  // clicks, same-page hash changes (symbol search on the current page), and
  // cross-page arrivals (#mspeed links from search results or the changelog).
  const findCard = (slug) => {
    const actualName = propertyMap[slug];
    if (!actualName) return null;
    for (const nameEl of document.querySelectorAll(".property-name")) {
      if (nameEl.textContent.trim() === actualName) {
        return nameEl.closest(".property-card");
      }
    }
    return null;
  };

  document.addEventListener("DOMContentLoaded", () => {
    const tocLinks = document.querySelectorAll('.right-sidebar a[href^="#"]');

    tocLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        const href = link.getAttribute("href");
        if (!href) return;
        const targetCard = findCard(href.slice(1));
        if (targetCard) {
          e.preventDefault();
          targetCard.scrollIntoView({ behavior: "smooth", block: "start" });
          // Update URL hash
          history.pushState(null, "", href);
        }
      });
    });

    // Arriving with a property hash: the browser scrolled to the hidden
    // heading (page bottom) - correct to the real card once layout settles.
    const correctHashScroll = () => {
      const targetCard = findCard(location.hash.slice(1));
      if (targetCard) {
        targetCard.scrollIntoView({ behavior: "auto", block: "start" });
      }
    };
    if (location.hash) requestAnimationFrame(correctHashScroll);
    window.addEventListener("hashchange", correctHashScroll);
  });
</script>
