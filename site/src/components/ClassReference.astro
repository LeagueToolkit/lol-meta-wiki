---
// Class Reference landing page: the headline numbers, then the domains to
// browse by. Everything is known at build time (categories.json), so the page
// ships no script.
import { domains, isAuthoredDomain } from "../utils/domains";
import DomainCards from "./DomainCards.astro";

const sum = (pick: (d: (typeof domains)[number]) => number) =>
  domains.reduce((n, d) => n + pick(d), 0);

// Counts cover classes that still exist in the game; removed classes keep
// their pages but shouldn't inflate the headline.
const stats = [
  { label: "Classes", value: sum((d) => d.counts.live) },
  { label: "Documented", value: sum((d) => d.counts.documented) },
  { label: "Domains", value: domains.filter((d) => isAuthoredDomain(d.id)).length },
];
---

<div id="class-reference" class="not-content">
  <div class="stats-row">
    {
      stats.map((stat) => (
        <div class="stat-box">
          <span class="stat-number">{stat.value.toLocaleString("en-US")}</span>
          <span class="stat-label">{stat.label}</span>
        </div>
      ))
    }
  </div>

  <div class="search-tip">
    💡 <strong>Tip:</strong> Use the search bar above to find any class instantly
  </div>

  <section class="section">
    <h2>Browse by domain</h2>
    <p class="section-desc">
      Every class sits in one domain, placed by what it derives from and what uses it.
      The sidebar is grouped the same way.
    </p>
    <DomainCards />
  </section>
</div>

<style>
  #class-reference {
    margin: 1rem 0;
  }

  .stats-row {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .stat-box {
    flex: 1;
    min-width: 150px;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 1rem;
    text-align: center;
  }

  .stat-number {
    display: block;
    font-size: 1.75rem;
    font-weight: bold;
    color: var(--sl-color-blue);
  }

  .stat-label {
    display: block;
    font-size: 0.85rem;
    color: var(--sl-color-gray-2);
    margin-top: 0.25rem;
  }

  .search-tip {
    background: var(--sl-color-blue-low);
    border-left: 3px solid var(--sl-color-blue);
    padding: 0.75rem 1rem;
    margin-bottom: 2rem;
    border-radius: 0.25rem;
    font-size: 0.9rem;
  }

  .section {
    margin-bottom: 2.5rem;
  }

  .section h2 {
    font-size: 1.25rem;
    margin: 0 0 0.5rem 0;
    color: var(--sl-color-text);
  }

  .section-desc {
    color: var(--sl-color-gray-2);
    font-size: 0.9rem;
    margin: 0 0 1rem 0;
  }

  @media (max-width: 768px) {
    .stats-row {
      flex-direction: column;
    }
  }
</style>
