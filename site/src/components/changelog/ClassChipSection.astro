---
// One "New classes" or "Removed classes" section. Both variants share this
// component, parameterized by `kind`. Entries are bucketed into inheritance
// families (see utils/classFamilies) so a patch that adds one base class plus
// 90 subclasses reads as one family instead of 91 unrelated chips; when
// nothing in the section shares a root, the flat chip list is kept.
import { groupByFamily } from "../../utils/classFamilies";
import ClassChipList from "./ClassChipList.astro";
import ClassFamilyGroup from "./ClassFamilyGroup.astro";
import CirclePlusIcon from "../icons/CirclePlusIcon.astro";
import TrashIcon from "../icons/TrashIcon.astro";
import type { ClassChange } from "../../types";

interface Props {
  kind: "added" | "removed";
  entries: ClassChange[];
  headingLevel: number; // 2 on single-build patches, 3 under a build heading
  anchor: boolean; // this section owns the #sec-<kind> jump target
}

const { kind, entries, headingLevel, anchor } = Astro.props;

const Htag = `h${headingLevel}`;
const meta = {
  added: {
    title: "New classes",
    sectionId: "sec-added",
    titleClass: "change-title-added",
  },
  removed: {
    title: "Removed classes",
    sectionId: "sec-removed",
    titleClass: "change-title-removed",
  },
}[kind];

const { families, loners } = groupByFamily(entries);
---

{
  entries.length > 0 && (
    <div class="change-section" id={anchor ? meta.sectionId : undefined}>
      <Htag class={`change-title ${meta.titleClass}`}>
        {kind === "added" ? (
          <CirclePlusIcon size={16} strokeWidth={2.5} />
        ) : (
          <TrashIcon size={16} strokeWidth={2.5} />
        )}
        {meta.title} <span class="count">{entries.length}</span>
      </Htag>

      {families.length === 0 ? (
        <ClassChipList kind={kind} entries={entries} />
      ) : (
        <div class="families">
          {families.map((f) => (
            <ClassFamilyGroup
              kind={kind}
              family={f.name}
              entries={f.entries}
              headingLevel={headingLevel + 1}
            />
          ))}
          {loners.length > 0 && (
            <ClassFamilyGroup
              kind={kind}
              family={null}
              entries={loners}
              headingLevel={headingLevel + 1}
            />
          )}
        </div>
      )}
    </div>
  )
}

<style>
  .families {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
</style>
