---
import type { DescendantNode } from "../types";
import type { Sibling } from "../utils/classGraph";

interface Props {
  currentClass: string;
  ancestorLevels: string[][];
  descendantTree: DescendantNode[];
  /** Other subclasses of this class's bases, A→Z (see utils/classGraph). */
  siblings: Sibling[];
  /** Removed class name → the patch it disappeared in. */
  removedIn: Record<string, string>;
  classIndex: Record<string, string>;
}

const {
  currentClass,
  ancestorLevels = [],
  descendantTree = [],
  siblings = [],
  removedIn,
  classIndex,
} = Astro.props;

// Nothing to show for classes with no inheritance relationships
if (ancestorLevels.length === 0 && descendantTree.length === 0) {
  return null;
}

function subtreeSize(node: DescendantNode): number {
  return 1 + node.children.reduce((n, c) => n + subtreeSize(c), 0);
}

const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;

// Class chip with an optional descendant count baked into the chip itself.
// A class the game no longer ships is marked with a dot and says so -
// otherwise the only way to tell is to open its page. The mark sits beside
// the name rather than across it: these are mono identifiers, and a rule
// through them costs more legibility than the state is worth.
function nodeChip(name: string, count?: number): string {
  const countHtml =
    count !== undefined
      ? `<span class="chip-count" title="${plural(count, "descendant")}">${count}</span>`
      : "";
  const removedPatch = removedIn[name];
  // Screen readers get no signal from the dot or the tooltip
  const noteHtml = removedPatch
    ? `<span class="chip-note"> (removed in patch ${removedPatch})</span>`
    : "";
  const dotHtml = removedPatch
    ? `<span class="chip-dot" aria-hidden="true"></span>`
    : "";
  const attrs = removedPatch
    ? ` title="Removed from the game in patch ${removedPatch}"`
    : "";
  const cls = removedPatch ? "chip chip-removed" : "chip";
  const body = `${dotHtml}<span class="chip-name">${name}${noteHtml}</span>${countHtml}`;
  const href = classIndex[name];
  if (href) {
    return `<a href="${href}" class="${cls} chip-link"${attrs}>${body}</a>`;
  }
  return `<span class="${cls}"${attrs}>${body}</span>`;
}

const descendantCount = descendantTree.reduce((n, c) => n + subtreeSize(c), 0);
const ancestorCount = ancestorLevels.reduce((n, l) => n + l.length, 0);

// Small trees render fully expanded; big ones keep the current class's
// direct children visible and collapse deeper branches behind <details>
const expandAll = descendantCount <= 40;

function nodeHtml(node: DescendantNode): string {
  if (node.children.length === 0) {
    return `<li><span class="node-row"><span class="twisty-spacer"></span>${nodeChip(node.name)}</span></li>`;
  }
  const kids = node.children.map(nodeHtml).join("");
  return (
    `<li><details${expandAll ? " open" : ""}>` +
    `<summary class="node-row">${nodeChip(node.name, subtreeSize(node) - 1)}</summary>` +
    `<ul>${kids}</ul>` +
    `</details></li>`
  );
}

// Current class node: never collapsible, its children always visible
const childrenHtml = descendantTree.map(nodeHtml).join("");
const currentLi =
  `<li><span class="node-row"><span class="twisty-spacer"></span>` +
  `<span class="current-class">${currentClass}<span class="badge">current</span></span></span>` +
  (childrenHtml ? `<ul>${childrenHtml}</ul>` : "") +
  `</li>`;

// Siblings sit in the same list as the current class, in their shared A→Z
// order: the base's subclasses read as one list with "you are here" marked
// in it, which is what a tree is for. They carry a descendant count but no
// twisty - their own branches live on their pages.
let treeHtml = currentLi;
if (siblings.length > 0) {
  const rows = siblings.map((s) => ({
    name: s.name,
    html:
      `<li><span class="node-row"><span class="twisty-spacer"></span>` +
      `${nodeChip(s.name, s.descendants > 0 ? s.descendants : undefined)}</span></li>`,
  }));
  rows.push({ name: currentClass, html: currentLi });
  // Same plain sort the generator orders descendants with
  rows.sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));
  treeHtml = rows.map((r) => r.html).join("");
}

// Wrap ancestor levels around it, deepest ancestor outermost. A level with
// several classes (multiple inheritance) renders its chips side by side.
for (const level of ancestorLevels) {
  const chips = level
    .map((n) => nodeChip(n))
    .join(`<span class="level-sep">&amp;</span>`);
  treeHtml =
    `<li><span class="node-row"><span class="twisty-spacer"></span>${chips}</span>` +
    `<ul>${treeHtml}</ul></li>`;
}
treeHtml = `<ul class="tree-root">${treeHtml}</ul>`;

const countsLabel = [
  ancestorCount > 0 ? plural(ancestorCount, "ancestor") : null,
  siblings.length > 0 ? plural(siblings.length, "sibling") : null,
  descendantCount > 0 ? plural(descendantCount, "descendant") : null,
]
  .filter(Boolean)
  .join(" · ");

// A crowded base can own hundreds of rows even with its deep branches
// folded. Past roughly a screenful the tree gets its own scroller, so it
// stops pushing the properties - the reason most readers are here - off the
// page, and the inline script below parks that scroller on the current class.
const openRows =
  ancestorLevels.length +
  1 +
  siblings.length +
  (expandAll ? descendantCount : descendantTree.length);
const tall = openRows > 26;

// A scrolling tree opens at the top - on a crowded base that is a screenful
// of siblings with the current class somewhere below the fold. Park the
// scroller on it instead. Emitted as raw HTML (rather than an Astro
// <script>) so it stays right where it sits and runs while the page is
// still parsing: a deferred module script would show the jump. Only tall
// trees carry it; the other ~5,000 class pages get nothing.
const scrollScript = tall
  ? `<script>
  (() => {
    const tree = document.querySelector(".tree-tall");
    const current = tree && tree.querySelector(".current-class");
    if (!current) return;
    tree.scrollTop =
      current.getBoundingClientRect().top -
      tree.getBoundingClientRect().top +
      tree.scrollTop -
      tree.clientHeight / 2;
  })();
</script>`
  : "";
---

<!-- data-pagefind-ignore: the tree names dozens of *other* classes; indexing it
     would make every class match searches for its ancestors/descendants -->
<div class="inheritance-section not-content" data-pagefind-ignore>
  <h2>
    Inheritance
    {countsLabel && <span class="counts">{countsLabel}</span>}
  </h2>

  <div class:list={["tree", { "tree-tall": tall }]} set:html={treeHtml} />
  <Fragment set:html={scrollScript} />
</div>

<style>
  .inheritance-section {
    margin-bottom: 2rem;
  }

  .inheritance-section h2 {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-top: 0;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .counts {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--sl-color-gray-3, #6b7280);
  }

  .tree {
    background: var(--sl-color-bg);
    padding: 0.625rem 0.875rem;
    border-radius: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    font-size: 0.8125rem;
    overflow-x: auto;
  }

  /* Keep a crowded family inside its own pane instead of letting it run the
     length of the page; contain stops the scroll chaining to the document. */
  .tree-tall {
    max-height: min(32rem, 70vh);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .tree :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.25rem;
  }

  .tree :global(ul.tree-root) {
    padding-left: 0;
  }

  .tree :global(li) {
    position: relative;
    padding: 0;
  }

  /* Connector lines (skipped on the root row) */
  .tree :global(ul:not(.tree-root) > li)::before {
    content: "";
    position: absolute;
    left: -0.8rem;
    top: 0.75rem;
    width: 0.6rem;
    height: 1px;
    background: var(--sl-color-gray-5, #e5e7eb);
  }

  .tree :global(ul:not(.tree-root) > li)::after {
    content: "";
    position: absolute;
    left: -0.8rem;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--sl-color-gray-5, #e5e7eb);
  }

  .tree :global(ul:not(.tree-root) > li:last-child)::after {
    bottom: auto;
    height: 0.75rem;
  }

  /* Every row is exactly one line high so the tree reads as a grid */
  .tree :global(.node-row) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    height: 1.5rem;
  }

  .tree :global(.twisty-spacer) {
    display: inline-block;
    width: 0.9rem;
    flex-shrink: 0;
  }

  /* Collapsible branches */
  .tree :global(summary.node-row) {
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .tree :global(summary.node-row)::-webkit-details-marker {
    display: none;
  }

  .tree :global(summary.node-row)::before {
    content: "\25B8"; /* ▸ */
    display: inline-flex;
    justify-content: center;
    width: 0.9rem;
    flex-shrink: 0;
    color: var(--sl-color-gray-3, #6b7280);
    font-size: 0.7rem;
    transition: transform 0.15s ease;
  }

  .tree :global(details[open] > summary.node-row)::before {
    transform: rotate(90deg);
  }

  .tree :global(.chip-count) {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--sl-color-gray-3, #6b7280);
    border-left: 1px solid var(--sl-color-gray-5, #e5e7eb);
    padding-left: 0.35rem;
    line-height: 1.2;
  }

  .tree :global(.level-sep) {
    color: var(--sl-color-gray-3, #6b7280);
    font-size: 0.7rem;
    user-select: none;
  }

  /* Same metrics as .chip so the row height stays constant */
  .tree :global(.current-class) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--sl-font-mono);
    font-weight: 700;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--sl-color-accent, #4f46e5);
    padding: 0.1rem 0.45rem;
    background: var(--sl-color-accent-low, #e0e7ff);
    border-radius: 0.375rem;
    border: 1px solid var(--sl-color-accent, #4f46e5);
    white-space: nowrap;
  }

  .tree :global(.badge) {
    font-size: 0.6rem;
    font-weight: 600;
    padding: 0 0.3rem;
    line-height: 1.5;
    background: var(--sl-color-accent, #4f46e5);
    color: white;
    border-radius: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Class reference chips */
  .tree :global(.chip) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.1rem 0.45rem;
    border-radius: 0.375rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--sl-color-gray-5);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .tree :global(.chip-link) {
    color: var(--sl-color-text);
    text-decoration: none;
  }

  .tree :global(.chip-link:hover) {
    background: rgba(79, 70, 229, 0.15);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }

  /* Gone from the game: a status dot on a muted, dash-outlined chip. Two
     signals besides the colour (the dot's presence and the dashed border),
     so the state survives a colourblind read without the name paying for
     it. */
  .tree :global(.chip-removed) {
    border-style: dashed;
    color: var(--sl-color-gray-3);
  }

  .tree :global(.chip-dot) {
    width: 0.34rem;
    height: 0.34rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ltk-danger) 85%, transparent);
  }

  .tree :global(a.chip-removed:hover) {
    color: var(--sl-color-text);
  }

  /* The removal is announced, not just drawn */
  .tree :global(.chip-note) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

</style>
