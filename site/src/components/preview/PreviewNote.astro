---
// The notice that marks content from the PBE preview. The caller supplies the
// sentence; an optional link sits at the end of the row.
import InfoIcon from "../icons/InfoIcon.astro";

interface Props {
  /** Target and label of the trailing link. */
  link?: { href: string; label: string };
}

const { link } = Astro.props;
---

<p class="preview-note" data-pagefind-ignore>
  <InfoIcon size={16} />
  <span><slot /></span>
  {link && <a class="preview-note-link" href={link.href}>{link.label}</a>}
</p>

<style>
  .preview-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--cl-changed) 35%, transparent);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--cl-changed) 8%, transparent);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .preview-note :global(svg) {
    flex-shrink: 0;
    color: var(--cl-changed-text);
  }

  .preview-note-link {
    margin-inline-start: auto;
    font-weight: 500;
    color: var(--sl-color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .preview-note-link:hover {
    text-decoration: underline;
  }
</style>
