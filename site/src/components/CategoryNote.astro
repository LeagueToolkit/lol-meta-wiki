---
// Shown on a class page only when no authored domain claims the class: it
// says why (used across domains, or not placed at all) and, for the unplaced
// ones, where to fix that. A class that sits in a domain needs no note - the
// breadcrumb above the title already says where it is.
import { getCategoriesUrl } from "../config/repo";
import { SHARED_DOMAIN, UNCATEGORIZED_DOMAIN, type ClassCategory } from "../types";
import { domainHref, domainOf } from "../utils/domains";
import EditIcon from "./icons/EditIcon.astro";
import InfoIcon from "./icons/InfoIcon.astro";

interface Props {
  category: ClassCategory;
}

const { category } = Astro.props;

// "A", "A and B", "A, B and C" - the separator that follows each domain
const usedBy = (category.usedByDomains ?? [])
  .map(domainOf)
  .filter((d) => d !== undefined)
  .map((d, i, all) => ({
    ...d,
    after: i === all.length - 1 ? "." : i === all.length - 2 ? " and " : ", ",
  }));
---

{
  category.domain === SHARED_DOMAIN && (
    <p class="category-note" data-pagefind-ignore>
      <InfoIcon size={16} />
      <span>
        <a href={domainHref(SHARED_DOMAIN)}>Shared</a> - used by classes in{" "}
        {usedBy.map((d) => <><a href={domainHref(d.id)}>{d.title}</a>{d.after}</>)}
      </span>
    </p>
  )
}

{
  category.domain === UNCATEGORIZED_DOMAIN && (
    <p class="category-note" data-pagefind-ignore>
      <InfoIcon size={16} />
      <span>
        <a href={domainHref(UNCATEGORIZED_DOMAIN)}>Uncategorized</a> - no domain
        claims this class yet.
      </span>
      <a
        class="category-edit"
        href={getCategoriesUrl()}
        target="_blank"
        rel="noopener noreferrer"
        title="Seed this class's family in db/categories.yaml on GitHub"
      >
        <EditIcon size={11} />
        Categorize
      </a>
    </p>
  )
}

<style>
  .category-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .category-note :global(svg) {
    flex-shrink: 0;
    color: var(--sl-color-gray-3);
  }

  .category-edit {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-inline-start: auto;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    font-size: 11px;
    font-weight: 500;
    color: var(--sl-color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .category-edit:hover {
    border-color: var(--sl-color-accent);
  }

  .category-edit :global(svg) {
    color: inherit;
  }
</style>
