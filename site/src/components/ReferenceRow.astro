---
import { typeDisplay } from "../utils/typeLinker";
import type { UsedByClass } from "../types";

interface Props {
  entry: UsedByClass;
  classIndex: Record<string, string>;
}

const { entry, classIndex } = Astro.props;
const classHref = classIndex[entry.name] ?? `/classes/${entry.name.toLowerCase()}`;
---

<li class="ref-row">
  <a class="ref-class" href={classHref}>{entry.name}</a>
  <span class="ref-props">
    {
      entry.props.map((p) => (
        <span class="ref-prop">
          <a class="ref-prop-name" href={`${classHref}#${p.slug}`}>
            {p.name}
          </a>
          <code class="type-code" set:html={typeDisplay(p, classIndex)} />
        </span>
      ))
    }
  </span>
</li>

<style>
  .ref-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--sl-color-gray-6, #f3f4f6);
  }

  .ref-row:last-child {
    border-bottom: 0;
  }

  .ref-class {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--sl-color-accent, #4f46e5);
    text-decoration: none;
  }

  .ref-class:hover {
    color: var(--sl-color-accent-high, #3730a3);
    text-decoration: underline;
  }

  .ref-props {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-left: auto;
  }

  .ref-prop {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
  }

  .ref-prop-name {
    font-size: 0.8125rem;
    color: var(--sl-color-gray-2, #4b5563);
    text-decoration: none;
  }

  .ref-prop-name:hover {
    color: var(--sl-color-white, #111827);
    text-decoration: underline;
  }

  .type-code {
    font-size: 0.75rem;
    color: var(--sl-color-white, #1f2937);
    font-weight: 500;
    border-radius: 0.375rem;
    border: 1px solid var(--sl-color-gray-5, #e5e7eb);
    /* not-content opts out of Starlight's inline-code styling; restore it */
    background: var(--sl-color-bg-inline-code, #f3f4f6);
    padding: 0.125rem 0.5rem;
  }

  /* Links produced by typeLinker (set:html, so :global is required). Scoped
     to .ref-prop: PropertyCard styles the same classes for its own chips, and
     a class page can show this section without any property cards. */
  .ref-prop :global(.type-chip .type-link) {
    color: var(--sl-color-accent, #4f46e5);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .ref-prop :global(.type-chip .type-link:hover) {
    color: var(--sl-color-accent-high, #3730a3);
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .ref-row {
      flex-direction: column;
      gap: 0.375rem;
    }

    .ref-props {
      margin-left: 0;
    }
  }
</style>
